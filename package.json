{
  "name": "askme-mcp",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "scripts": {
    "gate": "npm run format && npm run lint && npm run types && npm run test",
    "format": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "types": "tsc -p web && tsc -p .",
    "test": "vitest run --project static --project unit --project int --project browser",
    "test:live": "vitest run --project live",
    "conformance": "vitest run --project conformance",
    "checks": "ADR_CHECKS=1 vitest run --project static fitness/adr-checks.static.ts",
    "coverage": "vitest run --project unit --project int --coverage",
    "mutate": "node test/mutate.ts",
    "eval": "NODE_USE_ENV_PROXY=1 vitest run --config evals/vitest.config.ts",
    "eval:candidates": "EVAL_CANDIDATES=1 npm run eval",
    "eval:trial": "EVAL_TRIAL=1 npm run eval -- evals/trial.eval.ts",
    "build": "vite build web"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@stryker-mutator/core": "10.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "playwright": "1.56.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1149.0",
    "@aws-sdk/client-sqs": "3.1149.0",
    "@aws-sdk/client-ssm": "3.1149.0",
    "@aws-sdk/lib-dynamodb": "3.1149.0",
    "@clerk/react": "6.17.8",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@tanstack/react-query": "5.103.2",
    "jose": "6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  }
}
